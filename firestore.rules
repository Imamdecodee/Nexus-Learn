rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'theilmnexus@gmail.com';
    }

    match /services/{serviceId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /serviceRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
        'requestId', 'services', 'description', 'productType', 'quantity',
        'size', 'pages', 'colour', 'finishing', 'websiteType', 'pageCount',
        'features', 'organizationName', 'materials', 'deadline',
        'deadlineDate', 'state', 'city', 'address', 'name', 'phone',
        'whatsapp', 'email', 'organization', 'consent', 'status', 'paymentStatus',
        'productionStatus', 'deliveryStatus', 'createdAt'
      ])
      && request.resource.data.status == 'new'
      && request.resource.data.requestId is string
      && request.resource.data.name is string
      && request.resource.data.email is string
      && request.resource.data.services is list;
      allow read, update, delete: if isAdmin();
    }

    match /classroom_events/{eventId}/posts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.eventId == eventId
        && request.resource.data.memberName is string
        && request.resource.data.memberEmail is string
        && request.resource.data.content is string
        && request.resource.data.type is string;
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likedBy', 'likes', 'reportedBy', 'reports', 'updatedAt'
        ])
        && request.resource.data.likes is number
        && request.resource.data.reports is number);
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly([
          'memberId', 'memberName', 'memberRole', 'content', 'createdAt'
        ])
        && request.resource.data.memberId is string
        && request.resource.data.memberName is string
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000;
        allow update, delete: if isAdmin();
      }
    }
  }
}
