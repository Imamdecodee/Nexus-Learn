rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'theilmnexus@gmail.com';
    }

    function isCoordinator() {
      return isAdmin() || (request.auth != null && request.auth.token.role == 'coordinator');
    }

    function isInstructor() {
      return isAdmin() || (request.auth != null && (request.auth.token.role == 'instructor' || request.auth.token.role == 'tutor'));
    }

    function isCampusPresident() {
      return request.auth != null && request.auth.token.role == 'campus_president';
    }

    function canManageAcademic() {
      return isCoordinator() || isInstructor();
    }

    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /campus_feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.campusId == 'unilorin'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isCoordinator();
    }

    match /campuses/{campusId}/courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isCoordinator();
    }

    match /campuses/{campusId}/staff/{staffId} {
      allow read: if true;
      allow create, update, delete: if isCoordinator();
    }

    match /campuses/{campusId}/staff_profiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if isCoordinator();
    }

    match /services/{serviceId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /serviceRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
        'requestId', 'services', 'description', 'productType', 'quantity',
        'size', 'pages', 'colour', 'finishing', 'websiteType', 'pageCount',
        'features', 'organizationName', 'materials', 'deadline',
        'deadlineDate', 'state', 'city', 'address', 'name', 'phone',
        'whatsapp', 'email', 'organization', 'consent', 'status', 'paymentStatus',
        'productionStatus', 'deliveryStatus', 'createdAt'
      ])
      && request.resource.data.status == 'new'
      && request.resource.data.requestId is string
      && request.resource.data.name is string
      && request.resource.data.email is string
      && request.resource.data.services is list;
      allow read, update, delete: if isAdmin();
    }

    match /classroom_events/{eventId}/posts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.eventId == eventId
        && request.resource.data.memberName is string
        && request.resource.data.memberEmail is string
        && request.resource.data.content is string
        && request.resource.data.type is string;
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likedBy', 'likes', 'reportedBy', 'reports', 'updatedAt'
        ])
        && request.resource.data.likes is number
        && request.resource.data.reports is number);
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly([
          'memberId', 'memberName', 'memberRole', 'content', 'createdAt'
        ])
        && request.resource.data.memberId is string
        && request.resource.data.memberName is string
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000;
        allow update, delete: if isAdmin();
      }
    }

    match /channels/{channelId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.memberRole in ['Student', 'Staff']
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000;
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isCoordinator() || isInstructor() || isCampusPresident());
      allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if isCoordinator()
        || (request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'headline', 'bio', 'avatar', 'institution', 'level', 'format',
            'linkedin', 'github', 'portfolio', 'timezone', 'updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if resource.data.status == 'published' || canManageAcademic();
      allow create, update, delete: if canManageAcademic();
    }

    match /user_progress/{progressId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null
        && (request.auth.uid == request.resource.data.userId || isAdmin());
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.userId
          && request.resource.data.userId == resource.data.userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /live_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if canManageAcademic();
    }

    match /timetables/{timetableId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.userId || canManageAcademic());
      allow create, update, delete: if canManageAcademic();
    }

    match /attendance/{attendanceId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.userId || canManageAcademic());
      allow create, update, delete: if canManageAcademic();
    }

    match /notices/{noticeId} {
      allow read: if resource.data.status == 'published' || isCoordinator();
      allow create, update, delete: if isCoordinator();
    }

    match /payment_records/{paymentId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.userId || isCoordinator());
      allow create, update, delete: if isCoordinator();
    }

    match /project_reviews/{reviewId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.userId || isCoordinator());
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isCoordinator();
    }

    match /certificates/{certificateId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.userId || isCoordinator());
      allow create, update, delete: if isCoordinator();
    }

    match /staff/{staffId} {
      allow read: if true;
      allow create, update, delete: if isCoordinator();
    }

    match /fund_requests/{requestId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.requesterId || isCoordinator());
      allow create: if isCoordinator()
        || (request.auth != null && request.auth.uid == request.resource.data.requesterId);
      allow update, delete: if isCoordinator();
    }
  }
}
